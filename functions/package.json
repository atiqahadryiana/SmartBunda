{
  "name": "smartbunda-functions",
  "description": "Cloud Functions for SmartBunda (admin user management).",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
