rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role;
    }

    function hasPermission(permission) {
      return signedIn() &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.permissions != null &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid))
          .data
          .permissions
          .hasAny([permission]);
    }

    function isStaff() {
      return signedIn() && (userRole() in [
        'admin',
        'doctor',
        'nurse',
        'dietitian',
        'nutrition',
        'nutritionist',
        'ADMIN',
        'DOCTOR',
        'NURSE',
        'DIETITIAN',
        'NUTRITION',
        'NUTRITIONIST'
      ]);
    }

    function isAdmin() {
      return signedIn() && (userRole() in ['admin', 'ADMIN']);
    }

    function planOwner(planId) {
      return get(/databases/$(database)/documents/NutritionPlans/$(planId)).data.patientId;
    }

    function isPlanOwner(planId) {
      return signedIn() && planOwner(planId) == request.auth.uid;
    }

    match /Users/{userId} {
      allow read: if signedIn();
      // Only patients may create their own account (self-registration).
      // Doctor, Nurse, Dietitian, Nutritionist, and Administrator accounts are
      // created exclusively by an administrator via the admin dashboard.
      // An owner may update their own profile fields but not escalate their
      // role, permissions, or status.
      allow create: if isStaff()
        || (isOwner(userId)
            && request.resource.data.role in ['patient', 'PATIENT']);
      allow update: if isStaff()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions
            && request.resource.data.status == resource.data.status);
      allow delete: if isOwner(userId) || isStaff();
    }

    match /Foods/{foodId} {
      allow read: if signedIn();
      allow write: if isStaff() || hasPermission('foodDatabase');
    }

    match /FoodLogs/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
      match /Days/{dayId} {
        allow read, write: if isOwner(userId) || isStaff();
        match /Entries/{entryId} {
          allow read, write: if isOwner(userId) || isStaff();
        }
      }
    }

    match /FoodLogItems/{id} {
      allow read: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.patientId);
      allow create: if signedIn() &&
        (isStaff() ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.patientId);
      allow update: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.patientId ||
         request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.patientId);
      allow delete: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.patientId);
    }

    match /PatientProfiles/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    match /Pregnancies/{pregId} {
      allow create: if signedIn() &&
        (request.auth.uid == request.resource.data.patientId || isStaff());
      allow read, update, delete: if signedIn() &&
        (request.auth.uid == resource.data.patientId || isStaff());
    }

    match /HydrationLogs/{logId} {
      allow read: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.userId);
      allow create: if signedIn() &&
        (isStaff() || request.auth.uid == request.resource.data.userId);
      allow update: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == request.resource.data.userId);
      allow delete: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.userId);
    }

    match /Feedback/{id} {
      allow read: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.userId);
      allow create: if signedIn() &&
        (isStaff() || request.auth.uid == request.resource.data.userId);
      allow update: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.userId ||
         request.auth.uid == request.resource.data.userId);
      allow delete: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.userId);
    }

    match /Alerts/{id} {
      allow read: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.patientId);
      allow create: if signedIn() &&
        (isStaff() || request.auth.uid == request.resource.data.patientId);
      allow update: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.patientId ||
         request.auth.uid == request.resource.data.patientId);
      allow delete: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.patientId);
    }

    match /Appointments/{id} {
      allow read: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.patientId ||
         request.auth.uid == resource.data.providerId);
      allow create: if signedIn() &&
        (isStaff() ||
         request.auth.uid == request.resource.data.patientId ||
         request.auth.uid == request.resource.data.providerId);
      allow update, delete: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.patientId ||
         request.auth.uid == resource.data.providerId);
    }

    match /NutritionPlans/{id} {
      allow read: if signedIn() &&
        (isStaff() || request.auth.uid == resource.data.patientId);
      allow write: if isStaff();
    }

    match /NutritionTargets/{id} {
      allow read: if signedIn() &&
        (isStaff() || isPlanOwner(resource.data.planId));
      allow write: if isStaff();
    }

    match /Recommendations/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /Notifications/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /Reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        (request.auth.uid == request.resource.data.patientId || isStaff());
      allow update, delete: if signedIn() &&
        (request.auth.uid == resource.data.patientId || isStaff());
    }

    match /EducationContent/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /AuditLogs/{id} {
      allow read: if isStaff();
      allow write: if signedIn();
    }

    match /SystemSettings/{docId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Forward-compatible: consultations linked to an appointment. Readable by
    // the patient, the assigned professional, and staff; written by staff or
    // the assigned professional.
    match /Consultations/{id} {
      allow read: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.patientId ||
         request.auth.uid == resource.data.professionalId);
      allow create: if signedIn() &&
        (isStaff() ||
         request.auth.uid == request.resource.data.professionalId);
      allow update, delete: if isStaff() ||
        (signedIn() && request.auth.uid == resource.data.professionalId);
    }

    // Forward-compatible: 1:1 messages. Readable by sender, receiver, and
    // staff; created only by the sender.
    match /ChatMessages/{id} {
      allow read: if signedIn() &&
        (isStaff() ||
         request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.receiverId);
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isStaff() ||
        (signedIn() && request.auth.uid == resource.data.senderId);
    }
  }
}
